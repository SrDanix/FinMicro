# Copia este archivo como .env y ajusta los valores.

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: vacío = SQLite. Para PostgreSQL usa DB_ENGINE=postgresql
DB_ENGINE=
DB_NAME=finmicro
DB_USER=finmicro
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Pagos: mientras sea True, Khipu/Flow se simulan dentro de la app.
PAGOS_MODO_SIMULADO=True
KHIPU_API_KEY=
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://sandbox.flow.cl/api

# Detrás de HTTPS en producción (Nginx + certbot). En tu PC sin HTTPS: False
DJANGO_HTTPS=True
DJANGO_CSRF_TRUSTED_ORIGINS=https://TU_DOMINIO

# Correo (recuperación de contraseña e invitaciones). Por defecto se
# imprime en la consola. Para enviar de verdad (p. ej. Amazon SES):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FinMicro <no-responder@finmicro.cl>
